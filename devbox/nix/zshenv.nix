# devbox: the agent account's ~/.zshenv - the one file EVERY zsh reads, and the
# zsh counterpart of the ~/.bash_env the provisioning driver writes for bash. A
# human at a shell reads it, and so does `ssh <box> '<cmd>'`, which runs the
# login shell non-interactively and never reaches ~/.zshrc.
#
# ALWAYS PART OF THE GENERATION, and gated on no `devbox.mods.<name>.enable`
# flag: this is devbox's own shell plumbing, not an optional mod. That is why it
# sits beside options.nix rather than in modules/ - a file there is a mod NAME,
# one devbox resolves against the playbook and renders a flag for.
#
# ~/.zshenv AND NOTHING ELSE, which is the whole reason `programs.zsh` is not
# enabled here. At the pinned home-manager rev, `programs.zsh.enable` also makes
# the generation own `${dotDir}/.zshrc` (written unconditionally by
# modules/programs/zsh/default.nix) - and ~/.zshrc belongs to the `dotfiles`
# bash mod, which installs oh-my-zsh through configenv's setup.sh and edits that
# file in place. `dotfiles` runs AFTER `home-manager` in the workspace playbook,
# so it would replace the store symlink with a plain file, and the NEXT
# activation would refuse a file it does not own. The two halves therefore split
# BY FILE, disjointly: ~/.zshenv here, and ~/.zshrc, ~/.vimrc, ~/.tmux.conf,
# ~/.gitconfig, ~/.config/{jj,nvim} - everything configenv copies - there.
# Nothing else in an agent account writes ~/.zshenv, so a second activation
# finds its own symlink and is a no-op. A future module that wants
# `programs.zsh` conflicts with the `home.file` below at evaluation time, which
# is the loud failure it should be.
#
# NO CREDS, as everywhere in this flake: /nix/store is world-readable and shared
# by every attachment on the box. The file SOURCES the account's 0600
# ~/.config/devbox/env (written by `devbox sync --envvars`); no value from it is
# ever in a nix expression. The `[ -f ]` guard is what keeps the two independent
# - the env file is written by a different code path, and a zsh that starts
# before it exists simply has no creds.
{ config, ... }:
{
  # Where the bash mods install their binaries (jj, claude, cargo-binstall).
  # home.sessionPath lands in hm-session-vars.sh, which the file below sources -
  # as does any module's home.sessionVariables.
  home.sessionPath = [ "$HOME/.local/bin" ];

  home.file.".zshenv".text = ''
    # Generated by devbox's home-manager generation (nix/zshenv.nix).

    # This generation's session variables and PATH entries. Sourcing it twice is
    # a no-op (it guards itself), so a zsh started from a bash that already read
    # ~/.bash_env is unaffected.
    . "${config.home.sessionVariablesPackage}/etc/profile.d/hm-session-vars.sh"

    # This account's devbox-managed [env] creds, written 0600 by
    # `devbox sync --envvars`.
    [ -f "$HOME/.config/devbox/env" ] && . "$HOME/.config/devbox/env"
  '';
}
